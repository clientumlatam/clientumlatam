    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "apify-client": "^2.23.4",
    "bcryptjs": "^3.0.3",
