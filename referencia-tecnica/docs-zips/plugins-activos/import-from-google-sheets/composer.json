{
  "name": "gsw/importer-lite",
  "description": "Import Products to WooCommerce from Google Sheets - Free",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1",
    "gsw/core": "^1.0",
    "google/apiclient": "^2.18",
    "monolog/monolog": "^2.9",
    "psr/log": "^3.0",
    "guzzlehttp/guzzle": "^7.10"
  },
  "autoload": {
    "psr-4": {
      "GSW\\Lite\\": "src/"
    }
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
  },
  "extra": {
    "google/apiclient-services": [
      "Drive"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../gsw-core",
      "options": {
        "symlink": false
      }
    }
  ]
}
