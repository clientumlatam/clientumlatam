# =============================================================================
# Clientum CRM — Variables de entorno de referencia
# =============================================================================
# Copia este archivo a .env para desarrollo local y completá los valores reales.
# NUNCA commitees .env ni pegues claves reales en el código o en el chat.
# En producción (Replit + Vercel) los secretos se gestionan desde los paneles
# de cada plataforma, nunca desde archivos.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# El servidor intenta resolver la URL automáticamente via la API de Neon
# (usando NEON_API_KEY + NEON_PROJECT_ID). Si estas dos variables no están
# seteadas, cae al valor de DATABASE_URL como fallback.
# En desarrollo local con Neon, el más simple es setear DATABASE_URL directo.

# URL de conexión con pooler (recomendado para producción y serverless)
# Formato: postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# API key de Neon (permite resolver la connection string dinámicamente)
# Obtené la tuya en: https://console.neon.tech/app/account/api-keys
NEON_API_KEY="YOUR_NEON_API_KEY"

# ID del proyecto Neon (ej: "fragrant-leaf-12345678")
# Lo encontrás en la URL de la consola: console.neon.tech/app/projects/<NEON_PROJECT_ID>
NEON_PROJECT_ID="YOUR_NEON_PROJECT_ID"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN Y SESIONES
# -----------------------------------------------------------------------------
# Clave para firmar cookies de sesión de Express. Debe ser aleatoria y larga.
# Generá una con: openssl rand -base64 64
SESSION_SECRET="YOUR_SESSION_SECRET_MINIMUM_32_CHARS"

# Token compartido entre el plugin WordPress (class-crm-proxy.php) y el backend.
# Lo envían en el header X-CRM-Token en el webhook /api/webhooks/chatbot-lead.
# Generá uno con: openssl rand -hex 32
CRM_INTERNAL_TOKEN="YOUR_CRM_INTERNAL_TOKEN"

# -----------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL
# -----------------------------------------------------------------------------
# Google Gemini — requerido para todas las funciones de IA
# Obtené la tuya en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# -----------------------------------------------------------------------------
# PROSPECCIÓN (APIs opcionales — el sistema tiene fallback a Gemini sin ellas)
# -----------------------------------------------------------------------------
# Apify — scraping real de Google Maps
# Obtené el tuyo en: https://console.apify.com/account/integrations
APIFY_API_TOKEN="YOUR_APIFY_API_TOKEN"

# Google Maps Platform (Places API New) — prospección geolocalizada en tiempo real
# Habilitá "Places API (New)" en: https://console.cloud.google.com/apis/credentials
# Nota: en Vercel también debe configurarse en el dashboard de Vercel (no solo aquí)
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_PLATFORM_KEY"

# Alias legacy de GOOGLE_MAPS_PLATFORM_KEY — el servidor acepta ambos con || fallback
# Podés setear solo uno de los dos; dejá este vacío si usás el anterior
GOOGLE_MAPS_API_KEY=""

# Hunter.io — enriquecimiento de contactos (email + cargo por dominio)
# Obtené la tuya en: https://hunter.io/api-keys
HUNTER_API_KEY="YOUR_HUNTER_API_KEY"

# -----------------------------------------------------------------------------
# AGENTE SDR SANTI (Hermes → AI Prospector, server-to-server)
# -----------------------------------------------------------------------------
# API key que Hermes envía en el header X-Api-Key para autenticar llamadas al SDR.
# Generá una con: openssl rand -hex 32
SANTI_API_KEY="YOUR_SANTI_API_KEY"

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------
# URL pública del app deployado (usada para links self-referential)
APP_URL="https://www.clientum.com.ar"

# Puerto del servidor en desarrollo local (el default es 5000)
PORT=5000

# Entorno de ejecución. En producción Cloud Run/Vercel se setea automáticamente.
NODE_ENV="development"

# -----------------------------------------------------------------------------
# VARIABLES INYECTADAS AUTOMÁTICAMENTE — NO SETEAR MANUALMENTE
# -----------------------------------------------------------------------------
# VERCEL=1               → seteada por Vercel en producción (desactiva app.listen)
# DISABLE_HMR=true       → seteada por Replit cuando es necesario
# PGDATABASE, PGHOST, PGPORT, PGUSER, PGPASSWORD → Replit Postgres interno (legacy)
# -----------------------------------------------------------------------------
