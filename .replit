modules = ["nodejs-24", "python-base-3.13", "php-8.2", "postgresql-16"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21496
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "cd attached_assets-4/attached_assets/Chat-Export-1s && pnpm install --frozen-lockfile && PORT=5000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/clientum run build"]
publicDir = "attached_assets-4/attached_assets/Chat-Export-1s/artifacts/clientum/dist/public"

[userenv]

[userenv.shared]
HUNTER_API_KEY = "0711d0e54b9d37e59e30e8f15e6b62574675bb50"
